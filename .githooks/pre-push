#!/bin/sh
# Refuses pushes that update main from this clone. GitHub branch protection isn't available
# on this repo's plan, so this is a local guard only: `git push --no-verify` bypasses it.
# Enable with: git config core.hooksPath .githooks

protected="refs/heads/main"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$protected" ]; then
    echo "pre-push: direct pushes to main are not allowed. Push a branch and open a pull request." >&2
    exit 1
  fi
done

exit 0
